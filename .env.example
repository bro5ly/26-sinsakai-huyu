# docker-compose.yml が web・api・studio に読ませる環境変数の見本。
# cp .env.example .env で写し、JWT の鍵は自分で作った値を入れる(.env はコミットしない)

# DB(docker-compose.yml の db と同じ値。手元の開発用)
DATABASE_URL="postgresql://postgres:postgres@db:5432/sinsakai-huyu-db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sinsakai-huyu-db

# JWT の署名の鍵(タブレットの今のトークンだけが使う。0.8のeで消す)。長い乱数にする
# 作り方の例: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=

# 画面のURL(CORS で許す相手)
FRONTEND_URL=http://localhost:4545
