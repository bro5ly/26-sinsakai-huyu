# API(back/)が読む環境変数の見本(コンテナの中で dotenv が読む)。
# cp back/.env.example back/.env で写し、秘密の値は自分で入れる(.env はコミットしない)

DATABASE_URL="postgresql://postgres:postgres@db:5432/sinsakai-huyu-db?schema=public"

# ルートの .env と同じ値にする(タブレットの今のトークンだけが使う。0.8のeで消す)
JWT_ACCESS_SECRET=

# 認証コードのメールを送る SMTP。手元で試すなら Mailtrap などのテスト用の SMTP を使う。
# 空のままだと送れない(コードは Prisma Studio の verification_codes で見られる)
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="貸し出し管理システム <noreply@example.com>"

PORT=5454
FRONTEND_URL=http://localhost:4545
