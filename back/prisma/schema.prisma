// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enum 定義 ---

// 名簿上の種別(学校が決める)
enum UserType {
  STUDENT // 学生
  FACULTY // 教職員
  EXTERNAL // 外部利用者など
}

// このシステムでの権限(名簿ではなく、このシステムが決める)
enum Role {
  MEMBER // 一般
  ADMIN // 管理者(在庫管理ができる)
}

// 物そのものの状態。貸出中かどうかはここではなく、返却されていない Rental があるかで決まる
enum ItemStatus {
  AVAILABLE // 使える
  MAINTENANCE // メンテナンス・修理中
  LOST // 紛失
  DISPOSED // 廃棄済み
}

// セッションをどこで使うか。Webのセッションでタブレットの操作は通らず、その逆も通らない(docs/auth.md R-A18)
enum SessionKind {
  WEB // Webサイトのログイン
  TABLET // タブレットでカード + PINを通した人(0.8のeで使い始める)
}

// 通知の種類
enum NotificationType {
  RENTAL_CONFIRMATION // 貸出完了通知
  RETURN_REMINDER // 返却期限前のリマインド
  OVERDUE_ALERT // 延滞警告
  SYSTEM_NOTICE // システムからのお知らせ
}

// --- Models ---

// このシステムに登録した人。名前・メール・カードの番号などは名簿にだけ持ち、写さない。
// 名簿は名簿の窓口(src/features/roster)からだけ読む。本番の名簿は学校のDBかAPIなので、外部キーもリレーションも張らない
model User {
  id               String    @id @default(uuid()) @map("UniqueID")
  studentId        String    @unique @map("student_id")
  passwordHash     String    @map("password_hash")
  role             Role      @default(MEMBER)
  slackUserId      String?   @map("slack_user_id")
  slackTeamId      String?   @map("slack_team_id")
  canBorrow        Boolean   @default(true) @map("can_borrow")
  maxItems         Int       @default(5) @map("max_items")
  suspendedUntil   DateTime? @map("suspended_until")
  suspensionReason String?   @map("suspension_reason")
  isActive         Boolean   @default(true) @map("is_active")
  // タブレット用のPIN(数字4桁)。bcryptのハッシュだけを持つ。無ければ未登録(docs/auth.md R-A5)
  pinHash           String?   @map("pin_hash")
  // タブレットで続けて間違えた回数。5回でロックし、Webで登録し直すまで解かない(R-A7)。数えるのは0.8のe
  pinFailedAttempts Int       @default(0) @map("pin_failed_attempts")
  // ロックした日時。無ければロックしていない。時間では解けないので「いつまで」は持たない(P4)
  pinLockedAt       DateTime? @map("pin_locked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  rentals       Rental[]
  notifications Notification[]
  sessions      Session[]
  // この人が登録したタブレットの端末
  registeredTabletDevices TabletDevice[]

  @@map("user")
}

// 学校の名簿の仮の代わり(モック)。読むのはPrismaRosterだけ。本番の名簿に替えたら消す
model ExternalUser {
  id           String   @id @default(uuid()) @map("UniqueID")
  email        String   @unique
  slackUserId  String?  @map("slack_user_id")
  slackTeamId  String?  @map("slack_team_id")
  serialNumber String?  @unique @map("serial_number")
  userType     UserType @default(STUDENT) @map("user_type")
  name         String
  grade        String?
  major        String?
  studentId    String   @unique @map("student_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("external_user")
}

model VerificationCode {
  studentId String   @id @map("student_id")
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  // コードが合ったあとに渡す登録用トークン。番号そのものは持たず、ハッシュだけを持つ。登録で1回使ったら行ごと消す(docs/auth.md A8-8)
  tokenHash      String?   @unique @map("token_hash")
  tokenExpiresAt DateTime? @map("token_expires_at")

  @@map("verification_codes")
}

// ログインのセッション。番号そのものは持たず、SHA-256のハッシュだけを持つ(DBが漏れても、そのままは使えない)。
// 行を消せばすぐに使えなくなる。1人が複数の端末でログインできるように、利用者ごとに何件でも持てる(docs/spec.md Q9)
model Session {
  id        String      @id @default(uuid()) @map("UniqueID")
  tokenHash String      @unique @map("token_hash")
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      SessionKind
  expiresAt DateTime    @map("expires_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@map("session")
}

model Category {
  id          String   @id @default(uuid()) @map("UniqueID")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  genres Genre[]

  @@map("category")
}

model Genre {
  id          String   @id @default(uuid()) @map("UniqueID")
  categoryId  String   @map("category_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  itemTypes      ItemType[]
  itemTypeGenres ItemTypeGenre[]

  @@map("genre")
}

model ItemType {
  id               String   @id @default(uuid()) @map("UniqueID")
  genreId          String   @map("genre_id")
  title            String
  description      String?
  author           String?
  publisher        String?
  isbn             String?
  manufacturer     String?
  model            String?
  rentalPeriodDays Int      @map("rental_period_days")
  imageUrl         String?  @map("image_url")
  createdAt        DateTime @default(now()) @map("created_at")

  genre          Genre           @relation(fields: [genreId], references: [id])
  items          Item[]
  itemTypeGenres ItemTypeGenre[]

  @@map("item_type")
}

model ItemTypeGenre {
  id         String   @id @default(uuid()) @map("UniqueID")
  genreId    String   @map("genre_id")
  itemTypeId String   @map("item_type_id")
  createdAt  DateTime @default(now()) @map("created_at")

  genre    Genre    @relation(fields: [genreId], references: [id])
  itemType ItemType @relation(fields: [itemTypeId], references: [id])

  @@map("item_type_genres")
}

model Item {
  id         String     @id @default(uuid()) @map("UniqueID")
  itemTypeId String     @map("item_typeId")
  barcode    String     @unique
  location   String?
  status     ItemStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  itemType ItemType @relation(fields: [itemTypeId], references: [id])
  rentals  Rental[]

  @@map("item")
}

// 貸出中 = returnedAt が空、延滞 = 貸出中で dueDate を過ぎている。状態の列は持たない(returnedAt と食い違うため)
// 「返却されていない貸し出しは物1つにつき1件」はマイグレーションのSQLで部分インデックスにしている(Prismaでは書けない)
model Rental {
  id         String    @id @default(uuid()) @map("UniqueID")
  itemId     String    @map("itemId")
  userId     String    @map("userId")
  rentedAt   DateTime  @default(now()) @map("rented_at")
  dueDate    DateTime  @map("due_date")
  returnedAt DateTime? @map("returned_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  item          Item           @relation(fields: [itemId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  notifications Notification[]

  @@map("rental")
}

model Notification {
  id               String           @id @default(uuid()) @map("UniqueID")
  rentalId         String?          @map("rental_id")
  userId           String           @map("user_id")
  notificationType NotificationType @map("notification_type")
  status           String
  scheduledAt      DateTime         @map("scheduled_at")
  sentAt           DateTime?        @map("sent_at")
  slackChannelId   String?          @map("slack_channel_id")
  slackMessage     String?          @map("slack_message")
  retryCount       Int              @default(0) @map("retry_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  rental Rental? @relation(fields: [rentalId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@map("notification")
}

// 貸し出しを受け付けるタブレットの端末(docs/auth.md R-A1〜A3)。名前は管理者が付ける(例: 図書室入口)。
// 番号そのものは端末のCookieにだけ置き、ここにはSHA-256のハッシュだけを持つ。
// 取り消しても行は消さない(返却を受け付けた端末を、貸し出しの記録から指すため。D4)
model TabletDevice {
  id             String    @id @default(uuid()) @map("UniqueID")
  name           String
  tokenHash      String    @unique @map("token_hash")
  registeredById String    @map("registered_by_id")
  registeredBy   User      @relation(fields: [registeredById], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime? @map("last_used_at")
  // 取り消した日時。あれば、次の呼び出しから断る(R-A3)
  revokedAt      DateTime? @map("revoked_at")

  @@map("tablet_device")
}
